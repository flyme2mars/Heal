<?xml version="1.0" encoding="utf-8"?>
<!--
  Heal glass mark for adaptive icons.
  Black void + frosted disc + monochrome heart — matches chat chrome.
  Content kept inside the 66dp safe zone of the 108dp adaptive canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Frosted glass disc fill -->
    <path
        android:fillColor="#F5F5F7"
        android:fillAlpha="0.12"
        android:pathData="M54,31c12.7,0 23,10.3 23,23s-10.3,23 -23,23 -23,-10.3 -23,-23 10.3,-23 23,-23z" />

    <!-- Glass rim -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,31c12.7,0 23,10.3 23,23s-10.3,23 -23,23 -23,-10.3 -23,-23 10.3,-23 23,-23z"
        android:strokeWidth="1.5"
        android:strokeColor="#F5F5F7"
        android:strokeAlpha="0.28" />

    <!-- Specular highlight (glass edge catch) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M40.5,40c4.2,-5.2 10.5,-8 17.5,-8"
        android:strokeWidth="1.3"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.40"
        android:strokeLineCap="round" />

    <!-- Heart mark -->
    <path
        android:fillColor="#F5F5F7"
        android:fillType="nonZero"
        android:pathData="M54,71
            C54,71 35.8,58.5 35.8,47.2
            C35.8,40.9 40.6,36.5 46.2,36.5
            C49.6,36.5 52.5,38.2 54,40.9
            C55.5,38.2 58.4,36.5 61.8,36.5
            C67.4,36.5 72.2,40.9 72.2,47.2
            C72.2,58.5 54,71 54,71Z" />
</vector>
