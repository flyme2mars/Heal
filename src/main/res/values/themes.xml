<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MedGemma" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?android:attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?android:attr/isLightTheme</item>
    </style>

    <!-- Cold-start splash → Theme.MedGemma once MainActivity draws. -->
    <style name="Theme.MedGemma.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MedGemma</item>
    </style>
</resources>
