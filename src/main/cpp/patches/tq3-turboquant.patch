+    const block_q8_0  * GGML_RESTRICT y = (const block_q8_0 *)vy;
+
+    const int nb = n / QK_TQ3_0;
+
+    float sumf = 0.0f;
+    float tmp[QK_TQ3_0];
+
+    for (int i = 0; i < nb; ++i) {
+        // Dequantize TQ3_0 block to float (includes inverse WHT)
