+static inline void ggml_tq3_0_wht32_neon(float32x4_t * v) {
+    // Stage 5 (stride 16)
+    for (int i = 0; i < 4; i++) {
+        float32x4_t a = v[i];
+        float32x4_t b = v[i + 4];
+        v[i]     = vaddq_f32(a, b);
+        v[i + 4] = vsubq_f32(a, b);
+    }
+    // Stage 4 (stride 8)
+    for (int i = 0; i < 2; i++) {
+        for (int j = 0; j < 2; j++) {
+            float32x4_t a = v[i*4 + j];
+            float32x4_t b = v[i*4 + j + 2];
+            v[i*4 + j]     = vaddq_f32(a, b);
+            v[i*4 + j + 2] = vsubq_f32(a, b);
+        }
+    }
+    // Stage 3 (stride 4)
+    for (int i = 0; i < 4; i++) {
+        float32x4_t a = v[2*i];
+        float32x4_t b = v[2*i + 1];
+        v[2*i]     = vaddq_f32(a, b);
+        v[2*i + 1] = vsubq_f32(a, b);
