+            idx[2] = (qp[0] >> 6) | ((qp[1] << 2) & 0x07);
+            idx[3] = (qp[1] >> 1) & 0x07;
+            idx[4] = (qp[1] >> 4) & 0x07;
+            idx[5] = (qp[1] >> 7) | ((qp[2] << 1) & 0x07);
+            idx[6] = (qp[2] >> 2) & 0x07;
+            idx[7] = (qp[2] >> 5) & 0x07;
